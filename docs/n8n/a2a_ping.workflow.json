{
  "name": "uag A2A ping",
  "nodes": [
    {
      "parameters": {},
      "id": "c0a1b2c3-d4e5-4678-9abc-def012345601",
      "name": "When clicking ‘Execute workflow’",
      "type": "n8n-nodes-base.manualTrigger",
      "typeVersion": 1,
      "position": [0, 0]
    },
    {
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "a1",
              "name": "prompt",
              "value": "Reply with exactly: pong from uag",
              "type": "string"
            },
            {
              "id": "a2",
              "name": "correlation_id",
              "value": "={{ $execution.id }}",
              "type": "string"
            }
          ]
        },
        "options": {}
      },
      "id": "c0a1b2c3-d4e5-4678-9abc-def012345602",
      "name": "Set ping payload",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [240, 0]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ ($env.UAG_A2A_BASE_URL || 'http://127.0.0.1:8765').replace(/\\/$/, '') + '/message:send' }}",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
              "value": "=Bearer {{ $env.UAG_A2A_TOKEN }}"
            },
            {
              "name": "Content-Type",
              "value": "application/json"
            },
            {
              "name": "X-Correlation-Id",
              "value": "={{ $json.correlation_id }}"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"message\": {\n    \"role\": \"user\",\n    \"content\": {{ JSON.stringify($json.prompt) }}\n  },\n  \"returnImmediately\": false\n}",
        "options": {
          "timeout": 120000
        }
      },
      "id": "c0a1b2c3-d4e5-4678-9abc-def012345603",
      "name": "POST uag A2A message:send",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [500, 0]
    },
    {
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "b1",
              "name": "task_id",
              "value": "={{ $json.task.id }}",
              "type": "string"
            },
            {
              "id": "b2",
              "name": "task_status",
              "value": "={{ $json.task.status }}",
              "type": "string"
            },
            {
              "id": "b3",
              "name": "assistant_content",
              "value": "={{ $json.task.outputMessage ? $json.task.outputMessage.content : null }}",
              "type": "string"
            },
            {
              "id": "b4",
              "name": "error",
              "value": "={{ $json.task.error ? JSON.stringify($json.task.error) : null }}",
              "type": "string"
            }
          ]
        },
        "options": {}
      },
      "id": "c0a1b2c3-d4e5-4678-9abc-def012345604",
      "name": "Extract task fields",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [760, 0]
    }
  ],
