msgstr "تثبيت وإدارة المكونات الإضافية"

#: src/uagent/util_tools.py:2635
msgid ""
":plugin "
"<list|install|remove|enable|disable|reload|info|init|validate|marketplace> "
"..."
msgstr ""
":plugin <قائمة|تثبيت|إزالة|تمكين|تعطيل|إعادة تحميل|معلومات|init|التحقق من "
