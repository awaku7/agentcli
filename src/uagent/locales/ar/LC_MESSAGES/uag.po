#: src/uagent/core.py:442
msgid "[Responses API] A previous session was found. Continue it?"
msgstr "[Responses API] تم العثور على جلسة سابقة. الاستمرار في ذلك؟"

#: src/uagent/core.py:443
msgid "  (y) Yes - reuse previous context (saves tokens)"
msgstr "  (y) نعم - إعادة استخدام السياق السابق (يحفظ الرموز المميزة)"

#: src/uagent/core.py:444
msgid "  (n) No  - start fresh, discard saved state"
msgstr "  (n) لا - ابدأ من جديد، وتجاهل الحالة المحفوظة"

#: src/uagent/core.py:450
msgid "[Responses API] Continuing previous session."
msgstr "[Responses API] استمرار الجلسة السابقة."

#: src/uagent/core.py:453
msgid "[Responses API] Starting fresh session."
msgstr "[Responses API] بدء جلسة جديدة."

