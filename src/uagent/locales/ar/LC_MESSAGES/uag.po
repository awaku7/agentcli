msgstr "السجلات: عرض %(shown)d/%(total)d (dir=%(dir)s)"

#: src/uagent/core.py:899
msgid "Log files:"
msgstr "ملفات السجل:"

#: src/uagent/core.py:906
msgid "(mtime unknown)"
msgstr "(وقت التعديل غير معروف)"

#: src/uagent/core.py:1024 src/uagent/core.py:1027
msgid "(no user message)"
msgstr "(لا توجد رسالة من المستخدم)"

#: src/uagent/core.py:1032
#, python-format
msgid ""
"[%(idx)d] %(mtime_text)s | %(turns)d msgs | first: %(first_user)s | last:"
" %(last_user)s"
