msgstr "(ve více řádcích) restartujte vstup od začátku"

#: src/uagent/util_tools.py:2539
msgid "Show command help"
msgstr "Zobrazit nápovědu k příkazu"

#: src/uagent/util_tools.py:2540
msgid ":help [command [subcommand]]"
msgstr ":help [příkaz [dílčí příkaz]]"

#: src/uagent/util_tools.py:2542
msgid ""
"Without args: short list of all commands.\n"
"With a command: detailed usage (static + dynamic CMD_SPEC).\n"
"Examples: :help tools | :help skills install | :help plugin"
msgstr ""
"Bez argumentů: krátký seznam všech příkazů.\n"
"S příkazem: podrobné použití (statické + dynamické CMD_SPEC).\n"
"Příklady: Nástroje :help | Instalace dovedností :help | plugin :help"

#: src/uagent/util_tools.py:2549
msgid "Change workdir without confirmation"
msgstr "Změňte pracovní adresář bez potvrzení"

#: src/uagent/util_tools.py:2551
msgid "Examples: :cd .. | :cd ~ | :cd C:\\path | :cd /"
msgstr "Příklady: :cd .. | :cd ~ | :cd C:\\cesta | :cd/"

