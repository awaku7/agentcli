#: src/uagent/providers/llm_openai_responses.py:22
#, python-brace-format
msgid ""
"[Tool calling rules]\n"
"        - When calling a tool/function, you MUST provide function_call.arguments as a JSON object.\n"
"        - The JSON object MUST include all required parameters defined by the tool schema.\n"
"        - Never call a tool with an empty object {} unless the tool has no required parameters.\n"
"        - If you do not have a required parameter, ask the user for it using human_ask instead of guessing.\n"
"        "
msgstr ""
"[Pravidla volání nástroje]\n"
"        - Při volání nástroje/funkce MUSÍTE poskytnout function_call.arguments jako objekt JSON.\n"
"        - Objekt JSON MUSÍ obsahovat všechny požadované parametry definované schématem nástroje.\n"
"        - Nikdy nevolejte nástroj s prázdným objektem {}, pokud nástroj nemá žádné požadované parametry.\n"
"        - Pokud nemáte požadovaný parametr, požádejte o něj uživatele pomocí human_ask namísto hádání."

#: src/uagent/providers/llm_openai_responses.py:29
msgid ""
"[Web search rules]\n"
"        - Use web search only when fresh or external information is necessary.\n"
"        - Do not use web search for local or stable information.\n"
"        - Prefer answering without web search when the answer is already sufficient.\n"
"        "
msgstr ""
"[Pravidla webového vyhledávání]\n"
"        - Používejte webové vyhledávání pouze tehdy, když jsou potřeba čerstvé nebo externí informace.\n"
"        - Nepoužívejte webové vyhledávání pro místní nebo stabilní informace.\n"
"        - Pokud už je odpověď dostatečná, raději odpovídejte bez webového vyhledávání.\n"
"        "

