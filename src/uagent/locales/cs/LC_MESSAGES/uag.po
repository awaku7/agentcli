msgstr "Scaffolds src/uagent/tools/<název>_tool.py (+ json)."

#: src/uagent/util_tools.py:2633
msgid "Install and manage plugins"
msgstr "Nainstalujte a spravujte pluginy"

#: src/uagent/util_tools.py:2635
