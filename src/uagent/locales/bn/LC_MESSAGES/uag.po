msgstr "[sessions] ব্যবহার: :sessions prune --keep <N> [--dry-run|--yes]"

msgid "[sessions] --keep must be a non-negative integer."
msgstr "[sessions] --keep একটি অঋণাত্মক পূর্ণসংখ্যা হতে হবে।"

msgid "[sessions] Prune plan: keep newest %(keep)d, candidates=%(count)d"
