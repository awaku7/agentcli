msgstr ""
"[WARN] Historikkomprimeringen nådde kontextgränsen även vid chunk_size=1; "
"faller tillbaka till shrink_messages()."

#: src/uagent/core.py:2027
msgid ""
"[WARN] history compression could not reduce chunk_size further; falling back"
