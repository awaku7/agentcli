msgstr ""
"[WARN] Historikkomprimeringens kontextgräns överskreds; försöker igen med "
"chunk_size=%(chunk_size)d"

#: src/uagent/core.py:2045
msgid ""
"[WARN] history compression failed due to LLM error; falling back to "
