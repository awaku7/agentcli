msgstr ""
"[WARN] Historikkomprimeringen kunde inte minska chunk_size ytterligare; "
"faller tillbaka till shrink_messages()."

#: src/uagent/core.py:2035
#, python-format
msgid ""
"[WARN] history compression context length exceeded; retrying with "
