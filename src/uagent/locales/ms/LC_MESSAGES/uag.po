msgstr ""
"- Pastikan ringkasan ringkas tetapi sertakan keputusan penting, kekangan dan"
" item yang belum selesai.\n"

msgid "- Output should be directly usable as a system message."
msgstr ""
"- Output hendaklah boleh digunakan secara langsung sebagai mesej sistem."

msgid "Conversation chunk:\n"
msgstr "Bahagian perbualan:\n"

