msgstr "Vorherige Zusammenfassung:\n"

#: src/uagent/core.py:1721
msgid "New chunk:\n"
msgstr "Neuer Abschnitt:\n"

#: src/uagent/core.py:1723
msgid "Update the summary while keeping the prior context intact."
msgstr ""
"Aktualisieren Sie die Zusammenfassung, während der vorherige Kontext "
"intakt bleibt."

#: src/uagent/core.py:1734
