msgstr ":tools [daftar|muat|hidup|mati|muat ulang|keluaran|buat] ..."

#: src/uagent/util_tools.py:2618
msgid ""
":tools on|off           Enable/disable sending tools to the LLM\n"
":tools on|off <genre>   Enable/disable a tool genre (and sync global on)\n"
":tools list [query]     List loaded tools\n"
":tools load <name>      Load one tool by name\n"
":tools reload           Reload tool modules from disk\n"
":tools output           Toggle showing tool results in UI\n"
":tools create ...       Scaffold a new tool (alias of :tool create)"
msgstr ""
":tools aktif|mati Mengaktifkan/menonaktifkan alat pengiriman ke LLM\n"
":tools aktif|mati <genre> Mengaktifkan/menonaktifkan genre alat (dan menyinkronkan global aktif)\n"
":tools daftar [kueri] Daftar alat yang dimuat\n"
":tools memuat <nama> Memuat satu alat berdasarkan nama\n"
":tools memuat ulang Memuat ulang modul alat dari disk\n"
":tools keluaran Beralih menampilkan hasil alat di UI\n"
":tools buat ... Perancah alat baru (alias :tool create)"

