msgstr ""
"[WARN] Kompresi riwayat mencapai batas konteks bahkan pada chunk_size=1; "
"kembali ke shrink_messages()."

#: src/uagent/core.py:2027
msgid ""
"[WARN] history compression could not reduce chunk_size further; falling back"
