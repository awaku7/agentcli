msgid "Control tool sending, genres, and loaded tools"
msgstr "Hallitse työkalujen lähettämistä, tyylilajeja ja ladattuja työkaluja"

#: src/uagent/util_tools.py:2616
msgid ":tools [list|load|on|off|reload|output|create] ..."
msgstr ":tools [lista|lataa|päällä|pois|lataa|tulosta|luo] ..."

#: src/uagent/util_tools.py:2618
msgid ""
":tools on|off           Enable/disable sending tools to the LLM\n"
":tools on|off <genre>   Enable/disable a tool genre (and sync global on)\n"
":tools list [query]     List loaded tools\n"
":tools load <name>      Load one tool by name\n"
":tools reload           Reload tool modules from disk\n"
":tools output           Toggle showing tool results in UI\n"
":tools create ...       Scaffold a new tool (alias of :tool create)"
msgstr ""
":tools päällä|pois Ota käyttöön/poista käytöstä työkalujen lähettäminen LLM\n"
":tools päälle|pois <genre> Ota työkalulaji käyttöön/poista käytöstä (ja synkronoi yleinen päällä)\n"
":tools luettelo [kysely] Lista ladatut työkalut\n"
":tools lataa <nimi> Lataa yksi työkalu PH___0 uudelleenlataa levyltä PH__0 uudelleenlataa_0_0 reload_0 output Vaihda työkalutulosten näyttäminen käyttöliittymässä\n"
":tools luo ... Rakenna uusi työkalu (alias :tool create)"

