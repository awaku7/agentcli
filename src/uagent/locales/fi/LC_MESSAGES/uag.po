#: src/uagent/util_tools.py:2574
msgid ""
"Deletes scheck_log_*.jsonl where user-turn count (role=user) <= N (default "
"5, or UAGENT_CLEAN_THRESHOLD). On :exit/:quit/Ctrl-C, the current session "
"log is discarded under the same rule. A silent startup sweep also removes "
"leftover short logs from prior sessions."
msgstr ""
"Poistaa scheck_log_*.jsonl-tiedoston, jossa käyttäjän vuorojen määrä "
"(role=user) <= N (oletusarvo 5 tai UAGENT_CLEAN_THRESHOLD). Kohdassa "
":exit/:quit/Ctrl-C nykyinen istuntoloki hylätään saman säännön mukaisesti. "
"Hiljainen käynnistyspyyhkäisy poistaa myös jääneet lyhyet lokit "
"aikaisemmista istunnoista."

#: src/uagent/util_tools.py:2581
msgid "Shrink conversation history"
msgstr "Pienennä keskusteluhistoriaa"

#: src/uagent/util_tools.py:2582
msgid ":shrink [N]"
msgstr ":kutistua [N]"

#: src/uagent/util_tools.py:2583
