msgstr "पर्यावरण चल %(name)s सेट केलेले नाही."

#: src/uagent/core.py:875
msgid "No log files found."
msgstr "कोणत्याही लॉग फाइल्स आढळल्या नाहीत."

#: src/uagent/core.py:893
msgid "(unknown time)"
msgstr "(अज्ञात वेळ)"

#: src/uagent/core.py:896
#, python-format
msgid "logs: showing %(shown)d/%(total)d (dir=%(dir)s)"
msgstr "नोंदी: %(shown)d/%(total)d (dir=%(dir)s) दाखवत आहे"

#: src/uagent/core.py:899
msgid "Log files:"
msgstr "लॉग फाइल्स:"

#: src/uagent/core.py:906
msgid "(mtime unknown)"
msgstr "(बदलण्याची वेळ अज्ञात)"

#: src/uagent/core.py:1024 src/uagent/core.py:1027
