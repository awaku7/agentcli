msgstr ""
"[WARN] comprimarea istoricului hit context lungime chiar și la "
"chunk_size=1; revenind la shrink_messages()."

#: src/uagent/core.py:1798
msgid ""
"[WARN] history compression could not reduce chunk_size further; falling "
"back to shrink_messages()."
msgstr ""
"[WARN] compresia istoricului nu a putut reduce în continuare chunk_size; "
"revenind la shrink_messages()."

#: src/uagent/core.py:1806
#, python-format
msgid ""
"[WARN] history compression context length exceeded; retrying with "
