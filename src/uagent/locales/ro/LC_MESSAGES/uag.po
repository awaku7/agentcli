msgstr ":skills [listă|activ|clear|install|uninstall|apm|mp_search] ..."

#: src/uagent/util_tools.py:2526
msgid ""
"Built-in: list/active/clear (see runtime skills handlers).\n"
"Dynamic subcommands come from tool CMD_SPEC (install, uninstall, apm, "
"mp_search).\n"
"Use :help skills install for a subcommand."
msgstr ""
"Încorporat: list/activ/clear (consultați gestionarea competențelor de "
"rulare).\n"
"Subcomenzile dinamice provin din instrumentul CMD_SPEC (install, "
"uninstall, apm, mp_search).\n"
"Utilizați :help skills install pentru o subcomandă."

