msgstr "Mantieni gli ultimi N messaggi non di sistema (predefinito 40)."

#: src/uagent/util_tools.py:2586
msgid "Shrink history via LLM summarization"
msgstr "Riduci la cronologia tramite riepilogo LLM"

#: src/uagent/util_tools.py:2587
msgid ":shrink_llm [N]"
msgstr ":restringi_llm [N]"

#: src/uagent/util_tools.py:2589
