msgid "Manage and apply Agent Skills"
msgstr "Beheer en pas agentvaardigheden toe"

#: src/uagent/util_tools.py:2605
msgid ":skills [list|active|clear|install|uninstall|apm|mp_search] ..."
msgstr ""
":skills [lijst|actief|wissen|installeren|verwijderen|apm|mp_search] ..."

#: src/uagent/util_tools.py:2607
msgid ""
"Built-in: list/active/clear (see runtime skills handlers).\n"
":skills list <keyword>  Filter skills by keyword (name/description).\n"
":skills find <keyword>  Same as list with filter.\n"
"Dynamic subcommands come from tool CMD_SPEC (install, uninstall, apm, mp_search).\n"
"Use :help skills install for a subcommand."
msgstr ""
"Ingebouwd: list/active/clear (zie runtime skills handlers).\n"
":skills list <keyword> Filter skills op trefwoord (naam/beschrijving).\n"
":skills find <keyword> Hetzelfde als lijst met filter.\n"
"Dynamische subcommando's komen van de tool CMD_SPEC (install, uninstall, apm, mp_search).\n"
"Gebruik :help skills install voor een subcommando."

#: src/uagent/util_tools.py:2615
msgid "Control tool sending, genres, and loaded tools"
msgstr "Beheer het verzenden van tools, genres en geladen tools"

#: src/uagent/util_tools.py:2616
msgid ":tools [list|load|on|off|reload|output|create] ..."
msgstr ":tools [lijst|laden|aan|uit|herladen|uitvoer|maken] ..."

#: src/uagent/util_tools.py:2618
msgid ""
":tools on|off           Enable/disable sending tools to the LLM\n"
":tools on|off <genre>   Enable/disable a tool genre (and sync global on)\n"
":tools list [query]     List loaded tools\n"
":tools load <name>      Load one tool by name\n"
":tools reload           Reload tool modules from disk\n"
":tools output           Toggle showing tool results in UI\n"
":tools create ...       Scaffold a new tool (alias of :tool create)"
msgstr ""
":tools on|off In-/uitschakelen van het verzenden van tools naar LLM\n"
":tools on|off <genre> Een toolgenre in-/uitschakelen (en globaal synchroniseren aan)\n"
":tools list [query] Lijst geladen tools\n"
":tools load <naam> Eén tool op naam laden\n"
":tools reload Toolmodules opnieuw laden vanaf schijf\n"
":tools output Schakelen tussen weergave van toolresultaten in UI\n"
":tools create ... Een nieuwe tool bouwen (alias van :tool create)"

#: src/uagent/util_tools.py:2628
msgid "Tool authoring helpers"
msgstr "Hulpprogramma's voor het schrijven van tools"

#: src/uagent/util_tools.py:2629
msgid ":tool create <name> [--lang python|rust] [--description '...']"
msgstr ":tool create <naam> [--lang python|rust] [--beschrijving '...']"

