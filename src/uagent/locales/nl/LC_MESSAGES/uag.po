msgstr ""
"[WARN] De geschiedenis kon chunk_size niet verder verkleinen; terugval naar "
"shrink_messages()."

#: src/uagent/core.py:2051
#, python-format
msgid ""
"[WARN] history compression context length exceeded; retrying with "
