msgstr ""
"[INFO] shrink_llm: {old_n} -> {new_n} berichten ({old_part_n} oudere "
"berichten gecomprimeerd in 1 samenvatting; {tail_n} aan het einde behouden)"

#: src/uagent/core.py:1760
msgid ""
"[WARN] history compression hit context length even at chunk_size=1; falling "
"back to shrink_messages()."
msgstr ""
"[WARN] Geschiedeniskompressie bereikte zelfs bij chunk_size=1 de "
"contextlimiet; terugval naar shrink_messages()."

#: src/uagent/core.py:1770
msgid ""
"[WARN] history compression could not reduce chunk_size further; falling back"
" to shrink_messages()."
msgstr ""
"[WARN] De geschiedenis kon chunk_size niet verder verkleinen; terugval naar "
"shrink_messages()."

#: src/uagent/core.py:1778
#, python-format
msgid ""
"[WARN] history compression context length exceeded; retrying with "
"chunk_size=%(chunk_size)d"
msgstr ""
"[WARN] De contextlengte is overschreden bij geschiedeniskompressie; opnieuw "
"proberen met chunk_size=%(chunk_size)d"

#: src/uagent/core.py:1788
msgid ""
"[WARN] history compression failed due to LLM error; falling back to "
