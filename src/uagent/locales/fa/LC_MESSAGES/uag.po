msgstr "دستیاران تالیف ابزار"

#: src/uagent/util_tools.py:2629
msgid ":tool create <name> [--lang python|rust] [--description '...']"
msgstr ":tool create <name> [--lang python|rust] [--description '...']"

#: src/uagent/util_tools.py:2630
msgid "Scaffolds src/uagent/tools/<name>_tool.py (+ json)."
