#: src/uagent/core.py:1652
#, python-format
msgid "429 retry limit (%(max_retries)s) reached while history compression."
msgstr ""
"Grensen for 429 omstartsforsøk (%(max_retries)s) ble nådd under "
"historikkomprimering."

