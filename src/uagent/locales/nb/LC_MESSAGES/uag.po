msgstr "Tidligere oppsummering:\n"

#: src/uagent/core.py:1694
msgid "New chunk:\n"
msgstr "Ny del:\n"

#: src/uagent/core.py:1696
msgid "Update the summary while keeping the prior context intact."
msgstr ""
"Oppdater oppsummeringen mens du beholder den tidligere konteksten intakt."

#: src/uagent/core.py:1707
