msgstr ""
"[WARN] Стискання історії досягло межі контексту навіть за chunk_size=1; "
"повертаюся до shrink_messages()."

#: src/uagent/core.py:2027
msgid ""
"[WARN] history compression could not reduce chunk_size further; falling back"
