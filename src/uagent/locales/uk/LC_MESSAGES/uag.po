#: src/uagent/util_tools.py:2491
msgid ":clean [N]"
msgstr ":чистий [N]"

#: src/uagent/util_tools.py:2493
msgid ""
"Deletes scheck_log_*.jsonl where user-turn count (role=user) <= N "
"(default 5, or UAGENT_CLEAN_THRESHOLD). On :exit/:quit/Ctrl-C, the "
"current session log is discarded under the same rule. A silent startup "
"sweep also removes leftover short logs from prior sessions."
msgstr ""
"Видаляє scheck_log_*.jsonl, де кількість ходів користувача "
"(роль=користувач) <= N (за замовчуванням 5 або UAGENT_CLEAN_THRESHOLD). "
"На :exit/:quit/Ctrl-C поточний журнал сеансу скидається за тим самим "
"правилом. Безшумна перевірка запуску також видаляє залишки коротких "
"журналів із попередніх сеансів."

#: src/uagent/util_tools.py:2500
msgid "Shrink conversation history"
msgstr "Згорнути історію розмов"

#: src/uagent/util_tools.py:2501
msgid ":shrink [N]"
msgstr ":shrink [N]"

#: src/uagent/util_tools.py:2502
msgid "Keep last N non-system messages (default 40)."
msgstr "Зберігати останні N несистемних повідомлень (за замовчуванням 40)."

#: src/uagent/util_tools.py:2505
msgid "Shrink history via LLM summarization"
msgstr "Зменшити історію за допомогою узагальнення LLM"

#: src/uagent/util_tools.py:2506
msgid ":shrink_llm [N]"
msgstr ":shrink_llm [N]"

#: src/uagent/util_tools.py:2508
msgid ""
"Summarize older history into one system message; keep last N raw (default"
" 20)."
msgstr ""
"Узагальнити стару історію в одне системне повідомлення; залишити останні "
"N необробленими (за замовчуванням 20)."

#: src/uagent/util_tools.py:2512
msgid "Show approximate token count of the conversation"
msgstr "Показати приблизну кількість маркерів розмови"

#: src/uagent/util_tools.py:2513
msgid ":tokens"
msgstr ":токени"

#: src/uagent/util_tools.py:2516
msgid "Manage UAGENT_* environment variables"
msgstr "Керуйте змінними середовища UAGENT_*"

#: src/uagent/util_tools.py:2517
msgid ":env show [KEY] | :env set KEY=VAL | :env unset KEY | :env save"
msgstr ""
":env показати [КЛЮЧ] | :env встановити KEY=VAL | :env unset KEY | :env "
"зберегти"

#: src/uagent/util_tools.py:2519
msgid ""
"Sensitive KEY names are masked on show. save writes encrypted .env.sec "
"when configured."
msgstr ""
"Конфіденційні КЛЮЧОВІ імена маскуються на показі. save записує "
"зашифрований .env.sec під час налаштування."

#: src/uagent/util_tools.py:2523
msgid "Manage and apply Agent Skills"
msgstr "Керуйте та застосовуйте навички агента"

#: src/uagent/util_tools.py:2524
msgid ":skills [list|active|clear|install|uninstall|apm|mp_search] ..."
msgstr ":skills [список|активний|очистити|встановити|видалити|apm|mp_search] ..."

#: src/uagent/util_tools.py:2526
msgid ""
"Built-in: list/active/clear (see runtime skills handlers).\n"
"Dynamic subcommands come from tool CMD_SPEC (install, uninstall, apm, "
"mp_search).\n"
"Use :help skills install for a subcommand."
msgstr ""
"Вбудований: list/active/clear (див. обробники навичок виконання).\n"
"Динамічні підкоманди надходять із інструменту CMD_SPEC (інсталяція, "
"видалення, apm, mp_search).\n"
"Використовуйте :help навички встановлення для підкоманди."

#: src/uagent/util_tools.py:2532
msgid "Control tool sending, genres, and loaded tools"
msgstr "Керуйте надсиланням інструментів, жанрами та завантаженими інструментами"

#: src/uagent/util_tools.py:2533
msgid ":tools [list|load|on|off|reload|output|create] ..."
msgstr ""
":tools "
"[список|завантажити|увімкнути|вимкнути|перезавантажити|вивести|створити] "
"..."

#: src/uagent/util_tools.py:2535
msgid ""
":tools on|off           Enable/disable sending tools to the LLM\n"
":tools on|off <genre>   Enable/disable a tool genre (and sync global on)\n"
":tools list [query]     List loaded tools\n"
":tools load <name>      Load one tool by name\n"
":tools reload           Reload tool modules from disk\n"
":tools output           Toggle showing tool results in UI\n"
":tools create ...       Scaffold a new tool (alias of :tool create)"
msgstr ""
":tools увімк.|вимк. Увімкнути/вимкнути надсилання інструментів до LLM\n"
":tools увімкнути|вимкнути <жанр> Увімкнути/вимкнути жанр інструмента (і "
"синхронізувати глобально увімк.)\n"
":tools список [запит] Список завантажених інструментів\n"
":tools завантажити <ім’я> Завантажити один інструмент за назвою\n"
":tools перезавантажити Перезавантажити модулі інструментів із виводу "
"диска\n"
":tools Перемкнути показ результатів інструменту в інтерфейсі користувача\n"
":tools create ... Створити новий інструмент (псевдонім :tool create)"

