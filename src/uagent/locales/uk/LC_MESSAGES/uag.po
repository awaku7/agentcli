msgstr ""
"[WARN] Стискання історії не змогло зменшити chunk_size далі; повертаюся до "
"shrink_messages()."

#: src/uagent/core.py:2035
#, python-format
msgid ""
"[WARN] history compression context length exceeded; retrying with "
