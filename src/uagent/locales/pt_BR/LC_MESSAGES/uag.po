msgstr ""
"[INFO] Histórico de conversa em memória compactado: %(old_n)d -> "
"%(new_n)d mensagens (keep_last=%(keep_last)d)"

#: src/uagent/core.py:1652
#, python-format
msgid "429 retry limit (%(max_retries)s) reached while history compression."
msgstr ""
"Limite de tentativas 429 (%(max_retries)s) atingido durante a compressão "
