msgstr ":skills [lista|ativo|limpar|instalar|desinstalar|apm|mp_search] ..."

#: src/uagent/util_tools.py:2526
msgid ""
"Built-in: list/active/clear (see runtime skills handlers).\n"
"Dynamic subcommands come from tool CMD_SPEC (install, uninstall, apm, "
"mp_search).\n"
"Use :help skills install for a subcommand."
msgstr ""
"Integrado: list/active/clear (consulte manipuladores de habilidades de "
"tempo de execução).\n"
"Subcomandos dinâmicos vêm da ferramenta CMD_SPEC (instalar, desinstalar, "
"apm, mp_search).\n"
"Use :help skills install para um subcomando."

