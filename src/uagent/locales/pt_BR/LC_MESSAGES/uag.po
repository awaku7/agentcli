msgid "Control tool sending, genres, and loaded tools"
msgstr "Controle o envio de ferramentas, gêneros e ferramentas carregadas"

#: src/uagent/util_tools.py:2533
msgid ":tools [list|load|on|off|reload|output|create] ..."
msgstr ":tools [lista|carregar|ligar|desligar|recarregar|saída|criar] ..."

#: src/uagent/util_tools.py:2535
msgid ""
":tools on|off           Enable/disable sending tools to the LLM\n"
":tools on|off <genre>   Enable/disable a tool genre (and sync global on)\n"
":tools list [query]     List loaded tools\n"
":tools load <name>      Load one tool by name\n"
":tools reload           Reload tool modules from disk\n"
":tools output           Toggle showing tool results in UI\n"
":tools create ...       Scaffold a new tool (alias of :tool create)"
msgstr ""
":tools on|off Ativa/desativa o envio de ferramentas para LLM\n"
":tools on|off <gênero> Ativa/desativa um gênero de ferramenta (e "
"sincronização global ativada)\n"
":tools lista [consulta] Lista ferramentas carregadas\n"
":tools carregar <nome> Carregar uma ferramenta por nome\n"
":tools recarregar Recarregar módulos de ferramenta do disco\n"
":tools saída Alternar exibição dos resultados da ferramenta na UI\n"
":tools criar ... Crie uma nova ferramenta (apelido de :tool create)"

