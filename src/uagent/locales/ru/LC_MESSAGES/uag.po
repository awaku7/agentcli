msgstr "По умолчанию n=20."

#: src/uagent/util_tools.py:2614
msgid "Show the last n lines of a file"
msgstr "Показать последние n строк файла"

#: src/uagent/util_tools.py:2619
msgid "Reload runtime configuration / modules"
msgstr "Перезагрузить конфигурацию/модули времени выполнения."

#: src/uagent/util_tools.py:2620
msgid ":reload [target]"
msgstr ":перезагрузить [цель]"

