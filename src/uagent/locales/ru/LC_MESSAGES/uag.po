#: src/uagent/util_help.py:241
msgid "Set verbosity"
msgstr "Установить многословие"

#: src/uagent/util_help.py:243
msgid "0=off .. 3=high. No arg keeps current."
msgstr "0=выкл. 3=высокий. Ни один аргумент не сохраняет актуальность."

