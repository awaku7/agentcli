msgstr "Удалить файл(ы)/каталог(и) с предпросмотром и подтверждением"

#: src/uagent/util_tools.py:2606
msgid ":rm <path|glob>"
msgstr ":rm <путь|глоб>"

#: src/uagent/util_tools.py:2609
msgid "Show the first n lines of a file"
msgstr "Показать первые n строк файла"

#: src/uagent/util_tools.py:2611 src/uagent/util_tools.py:2616
