msgstr ""
"[INFO] shrink_llm: {old_n} -> {new_n} сообщений (сжато {old_part_n} старых "
"сообщений в 1 резюме; сохранено {tail_n} последних)"

#: src/uagent/core.py:2151
msgid ""
"[WARN] history compression hit context length even at chunk_size=1; falling "
