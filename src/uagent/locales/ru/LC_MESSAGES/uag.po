msgid "Exit the interactive session"
msgstr "Выйти из интерактивного сеанса"

#: src/uagent/util_tools.py:2622
msgid ":exit"
msgstr ":выход"

#: src/uagent/util_tools.py:2623
msgid ":quit"
msgstr ":выйти"

