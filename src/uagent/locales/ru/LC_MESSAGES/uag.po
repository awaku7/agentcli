msgstr "Копировать, перемещать, удалять пути"

#: src/uagent/util_tools.py:2396
msgid "Show file head/tail"
msgstr "Показать заголовок/конец файла"

#: src/uagent/util_tools.py:2397
msgid "Reload runtime pieces"
msgstr "Перезагрузить фрагменты времени выполнения"

#: src/uagent/util_tools.py:2398
msgid "Exit"
msgstr "Выход"

#: src/uagent/util_tools.py:2408
msgid "Dynamic commands (from tools CMD_SPEC):"
msgstr "Динамические команды (из инструментов CMD_SPEC):"

#: src/uagent/util_tools.py:2421
msgid "Hints:"
msgstr "Подсказки:"

#: src/uagent/util_tools.py:2423
msgid "Type :help <command> for details (e.g. :help tools, :help skills)."
msgstr ""
"Введите :help <команда> для получения подробной информации (например, "
":help инструментов, :help навыков)."

#: src/uagent/util_tools.py:2424
msgid "Enter a line that is just 'f' to enter multiline input mode."
msgstr ""
"Введите строку, состоящую из буквы «f», чтобы войти в режим "
"многострочного ввода."

#: src/uagent/util_tools.py:2425
msgid "(in multiline) restart input from the beginning"
msgstr "(в многострочном режиме) перезапустить ввод с начала"

#: src/uagent/util_tools.py:2458
msgid "Show command help"
msgstr "Показать справку по команде"

#: src/uagent/util_tools.py:2459
msgid ":help [command [subcommand]]"
msgstr ":help [команда [подкоманда]]"

#: src/uagent/util_tools.py:2461
msgid ""
"Without args: short list of all commands.\n"
"With a command: detailed usage (static + dynamic CMD_SPEC).\n"
"Examples: :help tools | :help skills install | :help plugin"
msgstr ""
"Без аргументов: краткий список всех команд.\n"
"С командой: подробное использование (статическое + динамическое "
"CMD_SPEC).\n"
"Примеры: :help инструменты | :help навыков установить | :help плагин"

#: src/uagent/util_tools.py:2468
msgid "Change workdir without confirmation"
msgstr "Изменить рабочий каталог без подтверждения"

#: src/uagent/util_tools.py:2470
msgid "Examples: :cd .. | :cd ~ | :cd C:\\path | :cd /"
msgstr "Примеры: :cd .. | :CD ~ | :cd C:\\путь | :кд/"

#: src/uagent/util_tools.py:2473
msgid "List directory entries"
msgstr "Список записей каталога"

#: src/uagent/util_tools.py:2474
msgid ":ls [path]"
msgstr ":ls [путь]"

#: src/uagent/util_tools.py:2475
msgid "Examples: :ls | :ls .. | :ls ~ | :ls C:\\path"
msgstr "Примеры: :ls | :лс .. | :лс ~ | :ls C:\\путь"

#: src/uagent/util_tools.py:2477
msgid "Show conversation log file list"
msgstr "Показать список файлов журнала разговоров"

#: src/uagent/util_tools.py:2477
msgid ":logs"
msgstr ": журналы"

#: src/uagent/util_tools.py:2479
msgid "Load a past log (overwrites current conversation history)"
msgstr "Загрузить прошлый журнал (перезаписывает текущую историю беседы)"

#: src/uagent/util_tools.py:2480
msgid ":load <idx|path>"
msgstr ":load <idx|путь>"

#: src/uagent/util_tools.py:2482
msgid ""
"idx is from :logs. After load you may be asked to prepend into the "
"current session log."
msgstr ""
"idx взят из :logs. После загрузки вас могут попросить добавить в журнал "
"текущего сеанса."

#: src/uagent/util_tools.py:2486
msgid "Load the newest log (:load 0)"
msgstr "Загрузите последний журнал (:load 0)"

#: src/uagent/util_tools.py:2487
msgid ":cont"
msgstr ":продолжение"

#: src/uagent/util_tools.py:2490
msgid "Delete short conversation logs"
msgstr "Удаление коротких журналов разговоров"

#: src/uagent/util_tools.py:2491
msgid ":clean [N]"
msgstr ":чистый [Н]"

#: src/uagent/util_tools.py:2493
msgid ""
"Deletes scheck_log_*.jsonl where user-turn count (role=user) <= N "
"(default 5, or UAGENT_CLEAN_THRESHOLD). On :exit/:quit/Ctrl-C, the "
"current session log is discarded under the same rule. A silent startup "
"sweep also removes leftover short logs from prior sessions."
msgstr ""
"Удаляет scheck_log_*.jsonl, где количество обращений пользователя "
"(role=user) <= N (по умолчанию 5 или UAGENT_CLEAN_THRESHOLD). При нажатии"
" :exit/:quit/Ctrl-C текущий журнал сеанса удаляется по тому же правилу. "
"Тихая очистка при запуске также удаляет оставшиеся короткие журналы "
"предыдущих сеансов."

#: src/uagent/util_tools.py:2500
msgid "Shrink conversation history"
msgstr "Сжать историю разговоров"

#: src/uagent/util_tools.py:2501
msgid ":shrink [N]"
msgstr ":сжать [Н]"

#: src/uagent/util_tools.py:2502
msgid "Keep last N non-system messages (default 40)."
msgstr "Сохранять последние N несистемных сообщений (по умолчанию 40)."

#: src/uagent/util_tools.py:2505
msgid "Shrink history via LLM summarization"
msgstr "Сжать историю с помощью суммирования LLM"

#: src/uagent/util_tools.py:2506
msgid ":shrink_llm [N]"
msgstr ":shrink_llm [Н]"

#: src/uagent/util_tools.py:2508
msgid ""
"Summarize older history into one system message; keep last N raw (default"
" 20)."
msgstr ""
"Обобщить старую историю в одно системное сообщение; сохранять последний N"
" необработанным (по умолчанию 20)."

#: src/uagent/util_tools.py:2512
msgid "Show approximate token count of the conversation"
msgstr "Показать приблизительное количество токенов разговора"

#: src/uagent/util_tools.py:2513
msgid ":tokens"
msgstr ": жетоны"

#: src/uagent/util_tools.py:2516
msgid "Manage UAGENT_* environment variables"
msgstr "Управление переменными среды UAGENT_*"

#: src/uagent/util_tools.py:2517
msgid ":env show [KEY] | :env set KEY=VAL | :env unset KEY | :env save"
msgstr ":env показать [КЛЮЧ] | :env set KEY=VAL | :env unset KEY | :env сохранить"

#: src/uagent/util_tools.py:2519
msgid ""
"Sensitive KEY names are masked on show. save writes encrypted .env.sec "
"when configured."
msgstr ""
"Чувствительные имена KEY скрыты при отображении. save записывает "
"зашифрованный .env.sec при настройке."

#: src/uagent/util_tools.py:2523
msgid "Manage and apply Agent Skills"
msgstr "Управляйте и применяйте навыки агента"

#: src/uagent/util_tools.py:2524
msgid ":skills [list|active|clear|install|uninstall|apm|mp_search] ..."
msgstr ":skills [список|активный|очистить|установить|удалить|apm|mp_search] ..."

#: src/uagent/util_tools.py:2526
msgid ""
"Built-in: list/active/clear (see runtime skills handlers).\n"
"Dynamic subcommands come from tool CMD_SPEC (install, uninstall, apm, "
"mp_search).\n"
"Use :help skills install for a subcommand."
msgstr ""
"Встроенные: list/active/clear (см. обработчики навыков во время "
"выполнения).\n"
"Динамические подкоманды поступают из инструмента CMD_SPEC (install, "
"uninstall, apm, mp_search).\n"
"Используйте :help навыки install для подкоманды."

#: src/uagent/util_tools.py:2532
msgid "Control tool sending, genres, and loaded tools"
msgstr "Отправка инструментов управления, жанры и загруженные инструменты"

#: src/uagent/util_tools.py:2533
msgid ":tools [list|load|on|off|reload|output|create] ..."
msgstr ""
":tools "
"[список|загрузить|включить|выключить|перезагрузить|вывести|создать] ..."

#: src/uagent/util_tools.py:2535
msgid ""
":tools on|off           Enable/disable sending tools to the LLM\n"
":tools on|off <genre>   Enable/disable a tool genre (and sync global on)\n"
":tools list [query]     List loaded tools\n"
":tools load <name>      Load one tool by name\n"
":tools reload           Reload tool modules from disk\n"
":tools output           Toggle showing tool results in UI\n"
":tools create ...       Scaffold a new tool (alias of :tool create)"
msgstr ""
":tools on|off Включить/отключить отправку инструментов в LLM\n"
":tools on|off <genre> Включить/отключить жанр инструмента (и глобальную "
"синхронизацию включить)\n"
":tools list [query] Список загруженных инструментов\n"
":tools load <name> Загрузить один инструмент по имени\n"
":tools reload Перезагрузить модули инструментов с диска\n"
":tools вывод Переключить отображение результатов инструмента в UI\n"
":tools create... Создайте новый инструмент (псевдоним :tool create)"

#: src/uagent/util_tools.py:2545
msgid "Tool authoring helpers"
msgstr "Помощники по созданию инструментов"

#: src/uagent/util_tools.py:2546
msgid ":tool create <name> [--lang python|rust] [--description '...']"
msgstr ":tool create <имя> [--lang python|rust] [--description '...']"

#: src/uagent/util_tools.py:2547
msgid "Scaffolds src/uagent/tools/<name>_tool.py (+ json)."
msgstr "Скаффолды src/uagent/tools/<имя>_tool.py (+ json)."

#: src/uagent/util_tools.py:2550
msgid "Install and manage plugins"
msgstr "Устанавливайте и управляйте плагинами"

#: src/uagent/util_tools.py:2551
msgid ""
":plugin "
"<list|install|remove|enable|disable|reload|info|init|validate|marketplace>"
" ..."
msgstr ""
":plugin "
"<список|установить|удалить|включить|отключить|перезагрузить|информация|инициализация|проверить|торговую"
" площадку> ..."

#: src/uagent/util_tools.py:2552
msgid "See :help plugin <subcommand> for each action."
msgstr "См. плагин :help <подкоманда> для каждого действия."

#: src/uagent/util_tools.py:2555
msgid "Auto-pilot: repeatedly pursue a goal until done or stopped"
msgstr ""
"Автопилот: постоянно добивайтесь цели, пока она не будет достигнута или "
"не остановлена."

#: src/uagent/util_tools.py:2556
msgid ":auto <goal> [--max-rounds N] | :auto off"
msgstr ":auto <цель> [--max-rounds N] | :auto отключено"

#: src/uagent/util_tools.py:2557
msgid "Press x in CLI to request immediate exit from auto-pilot."
msgstr ""
"Нажмите x в интерфейсе командной строки, чтобы запросить немедленный "
"выход из режима автопилота."

#: src/uagent/util_tools.py:2560
msgid "Show detailed model configuration"
msgstr "Показать подробную конфигурацию модели"

#: src/uagent/util_tools.py:2561
msgid ":model"
msgstr ":model"

#: src/uagent/util_tools.py:2562
msgid "Chat, image, audio, translation, embedding as configured."
msgstr "Чат, изображение, аудио, перевод, встраивание по настроению."

#: src/uagent/util_tools.py:2565
msgid "Set reasoning effort"
msgstr "Установить усилие рассуждения"

#: src/uagent/util_tools.py:2566
msgid ":r [0|1|2|3|auto|minimal|low|medium|high|xhigh]"
msgstr ":r [0|1|2|3|авто|минимальный|низкий|средний|высокий|xвысокий]"

#: src/uagent/util_tools.py:2567
msgid "0=off, 1=low, 2=medium, 3=high. Provider support varies."
msgstr ""
"0=выкл., 1=низкий, 2=средний, 3=высокий. Поддержка со стороны провайдера "
"варьируется."

#: src/uagent/util_tools.py:2571
msgid "Set verbosity"
msgstr "Установить многословие"

#: src/uagent/util_tools.py:2572
msgid ":v [0|1|2|3]"
msgstr ":v [0|1|2|3]"

#: src/uagent/util_tools.py:2573
msgid "0=off .. 3=high. No arg keeps current."
msgstr "0=выкл. 3=высокий. Ни один аргумент не сохраняет актуальность."

#: src/uagent/util_tools.py:2576
msgid "List long-term memory notes"
msgstr "Записи долговременной памяти:"

#: src/uagent/util_tools.py:2576
msgid ":mem-list"
msgstr ":список памяти"

#: src/uagent/util_tools.py:2578
msgid "Delete a long-term memory note by index"
msgstr "Удалить заметку долговременной памяти по индексу"

#: src/uagent/util_tools.py:2580
msgid "Index from :mem-list."
msgstr "Индекс из :mem-list."

#: src/uagent/util_tools.py:2583
msgid "Show or generate the learned user profile"
msgstr "Показать или создать изученный профиль пользователя"

#: src/uagent/util_tools.py:2584
msgid ":profile | :profile fromlog [N]"
msgstr ":профиль | :профиль из журнала [N]"

#: src/uagent/util_tools.py:2585
msgid "fromlog N uses the most recent N log files."
msgstr "fromlog N использует самые последние N файлов журналов."

#: src/uagent/util_tools.py:2589
msgid "Generate user profile from past logs"
msgstr "Создать профиль пользователя из прошлых журналов"

#: src/uagent/util_tools.py:2590
msgid ":profile-fromlog [N]"
msgstr ":profile-fromlog [N]"

#: src/uagent/util_tools.py:2591
msgid "Default N=100; 0=all."
msgstr "По умолчанию N=100; 0 = все."

#: src/uagent/util_tools.py:2594
msgid "Clear learned user profile data"
msgstr "Очистить полученные данные профиля пользователя"

#: src/uagent/util_tools.py:2594
msgid ":profile-clear"
msgstr ":профиль-очистить"

#: src/uagent/util_tools.py:2597
msgid "Copy file or directory"
msgstr "Копировать файл или каталог"

#: src/uagent/util_tools.py:2601
msgid "Move file or directory"
msgstr "Переместить файл или каталог"

#: src/uagent/util_tools.py:2605
