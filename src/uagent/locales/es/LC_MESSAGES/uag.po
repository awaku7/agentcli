msgstr "Resumen anterior:\n"

#: src/uagent/core.py:1966
msgid "New chunk:\n"
msgstr "Nuevo fragmento:\n"

#: src/uagent/core.py:1968
msgid "Update the summary while keeping the prior context intact."
msgstr "Actualice el resumen manteniendo intacto el contexto anterior."

