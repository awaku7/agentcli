msgid ":tools [list|load|on|off|reload|output|create] ..."
msgstr ":tools [lista|carga|activado|apagado|recargar|salida|crear] ..."

#: src/uagent/util_tools.py:2535
msgid ""
":tools on|off           Enable/disable sending tools to the LLM\n"
":tools on|off <genre>   Enable/disable a tool genre (and sync global on)\n"
":tools list [query]     List loaded tools\n"
":tools load <name>      Load one tool by name\n"
":tools reload           Reload tool modules from disk\n"
":tools output           Toggle showing tool results in UI\n"
":tools create ...       Scaffold a new tool (alias of :tool create)"
msgstr ""
":tools on|off Habilitar/deshabilitar el envío de herramientas al LLM\n"
":tools on|off <género> Habilitar/deshabilitar un género de herramienta (y"
" sincronización global activada)\n"
":tools lista [consulta] Listar herramientas cargadas\n"
":tools cargar <nombre> Cargar una herramienta por nombre\n"
":tools recargar Recargar módulos de herramientas desde el disco\n"
":tools salida Alternar mostrar resultados de herramientas en UI\n"
":tools crear... Crear una nueva herramienta (alias de :tool create)"

