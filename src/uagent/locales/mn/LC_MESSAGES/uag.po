msgid "Set verbosity"
msgstr "Нарийвчилсан мэдээллийг тохируулах"

#: src/uagent/util_tools.py:2572
msgid ":v [0|1|2|3]"
msgstr ":v [0|1|2|3]"

#: src/uagent/util_tools.py:2573
msgid "0=off .. 3=high. No arg keeps current."
msgstr "0=унтраах .. 3=өндөр. Ямар ч arg одоогийн хэвээр байна."

