msgstr "Жишээ нь: :ls | :ls .. | :ls ~ | :ls C:\\ зам"

#: src/uagent/util_tools.py:2477
msgid "Show conversation log file list"
msgstr "Харилцааны бүртгэлийн файлын жагсаалтыг харуулах"

#: src/uagent/util_tools.py:2477
msgid ":logs"
msgstr ":лог"

#: src/uagent/util_tools.py:2479
msgid "Load a past log (overwrites current conversation history)"
msgstr "Өнгөрсөн логыг ачаалах (одоогийн харилцан ярианы түүхийг дарж бичнэ)"

#: src/uagent/util_tools.py:2480
msgid ":load <idx|path>"
msgstr ": ачаалах <idx|зам>"

#: src/uagent/util_tools.py:2482
msgid ""
"idx is from :logs. After load you may be asked to prepend into the "
"current session log."
msgstr ""
"idx нь :logs-ээс. Ачаалсны дараа танаас одоогийн сессийн бүртгэлд "
"оруулахыг хүсэх болно."

#: src/uagent/util_tools.py:2486
msgid "Load the newest log (:load 0)"
msgstr "Хамгийн сүүлийн бүртгэлийг ачаалах (:ачаалах 0)"

#: src/uagent/util_tools.py:2487
msgid ":cont"
msgstr ":үргэлжлэл"

#: src/uagent/util_tools.py:2490
msgid "Delete short conversation logs"
msgstr "Богино ярианы бүртгэлийг устгах"

#: src/uagent/util_tools.py:2491
msgid ":clean [N]"
msgstr ":цэвэр [N]"

#: src/uagent/util_tools.py:2493
msgid ""
"Deletes scheck_log_*.jsonl where user-turn count (role=user) <= N "
"(default 5, or UAGENT_CLEAN_THRESHOLD). On :exit/:quit/Ctrl-C, the "
"current session log is discarded under the same rule. A silent startup "
"sweep also removes leftover short logs from prior sessions."
msgstr ""
"Хэрэглэгчийн эргэлтийн тоо (үүрэг=хэрэглэгч) <= N (өгөгдмөл 5 эсвэл "
"UAGENT_CLEAN_THRESHOLD) scheck_log_*.jsonl-г устгана. :exit/:quit/Ctrl-C "
"дээр одоогийн сессийн бүртгэлийг ижил дүрмийн дагуу устгана. Чимээгүй "
"эхлүүлэх нь өмнөх сессүүдээс үлдсэн богино бүртгэлийг устгадаг."

#: src/uagent/util_tools.py:2500
msgid "Shrink conversation history"
msgstr "Харилцааны түүхийг багасгах"

#: src/uagent/util_tools.py:2501
msgid ":shrink [N]"
msgstr ":багасгах [N]"

#: src/uagent/util_tools.py:2502
msgid "Keep last N non-system messages (default 40)."
msgstr "Сүүлийн N системийн бус мессежийг хадгал (анхдагч 40)."

#: src/uagent/util_tools.py:2505
msgid "Shrink history via LLM summarization"
msgstr "LLM хураангуйгаар түүхийг багасга"

#: src/uagent/util_tools.py:2506
msgid ":shrink_llm [N]"
msgstr ":shrink_llm [N]"

#: src/uagent/util_tools.py:2508
msgid ""
"Summarize older history into one system message; keep last N raw (default"
" 20)."
msgstr ""
"Хуучин түүхийг нэг системийн мессеж болгон нэгтгэн дүгнэх; Сүүлийн N "
"түүхийг хадгалах (анхдагч 20)."

#: src/uagent/util_tools.py:2512
msgid "Show approximate token count of the conversation"
msgstr "Харилцан ярианы ойролцоо токеныг харуул"

#: src/uagent/util_tools.py:2513
msgid ":tokens"
msgstr ":жетон"

#: src/uagent/util_tools.py:2516
msgid "Manage UAGENT_* environment variables"
msgstr "UAGENT_* орчны хувьсагчдыг удирдах"

#: src/uagent/util_tools.py:2517
msgid ":env show [KEY] | :env set KEY=VAL | :env unset KEY | :env save"
msgstr ""
":env харуулах [ТҮЛХҮҮР] | :env тохируулсан KEY=VAL | :env unset KEY | "
":env хадгалах"

#: src/uagent/util_tools.py:2519
msgid ""
"Sensitive KEY names are masked on show. save writes encrypted .env.sec "
"when configured."
msgstr ""
"Мэдрэмжтэй ТҮЛХҮҮР нэрийг шоунд далдалсан байна. тохируулсан үед "
"шифрлэгдсэн .env.sec бичдэг хадгалах."

#: src/uagent/util_tools.py:2523
msgid "Manage and apply Agent Skills"
msgstr "Агентын ур чадварыг удирдаж, хэрэгжүүлээрэй"

#: src/uagent/util_tools.py:2524
msgid ":skills [list|active|clear|install|uninstall|apm|mp_search] ..."
msgstr ":skills [жагсаалт|идэвхтэй|цэвэр|суулгах|устгах|apm|mp_search] ..."

#: src/uagent/util_tools.py:2526
msgid ""
"Built-in: list/active/clear (see runtime skills handlers).\n"
"Dynamic subcommands come from tool CMD_SPEC (install, uninstall, apm, "
"mp_search).\n"
"Use :help skills install for a subcommand."
msgstr ""
"Баригдсан: жагсаалт/идэвхтэй/тодорхой (ажлын цагийн ур чадвар "
"зохицуулагчийг харна уу).\n"
"Динамик дэд командууд нь CMD_SPEC хэрэглүүрээс ирдэг (суулгах, устгах, "
"apm, mp_хайл)."

#: src/uagent/util_tools.py:2532
msgid "Control tool sending, genres, and loaded tools"
msgstr "Хэрэгслийн илгээлт, төрөл, ачаалагдсан хэрэгслийг хянах"

#: src/uagent/util_tools.py:2533
msgid ":tools [list|load|on|off|reload|output|create] ..."
msgstr ":tools [жагсаалт|ачаалах|асах|унтраах|дахин ачаалах|гаралт|үүсгэх] ..."

#: src/uagent/util_tools.py:2535
msgid ""
":tools on|off           Enable/disable sending tools to the LLM\n"
":tools on|off <genre>   Enable/disable a tool genre (and sync global on)\n"
":tools list [query]     List loaded tools\n"
":tools load <name>      Load one tool by name\n"
":tools reload           Reload tool modules from disk\n"
":tools output           Toggle showing tool results in UI\n"
":tools create ...       Scaffold a new tool (alias of :tool create)"
msgstr ""
":tools асаалттай|унтраах LLM\n"
":tools руу илгээх хэрэгслийг идэвхжүүлэх/идэвхгүй болгох|унтраах <төрөл> "
"Хэрэгслийн төрлийг идэвхжүүлэх/идэвхгүй болгох (болон глобал синхрончлох)"
" \n"
":tools жагсаалт [асуулга] Ачаалагдсан хэрэгслүүдийг жагсаах\n"
":tools ачаалах <нэр> Нэг хэрэгслийг PH_0 нэрээр ачаалах disk\n"
":tools гаралт UI\n"
":tools үүсгэхэд хэрэглүүрийн үр дүнг харуулахыг асаах/унтраах ... Шинэ "
"хэрэгсэл үүсгэх (:tool create-ын алиа нэр)"

#: src/uagent/util_tools.py:2545
msgid "Tool authoring helpers"
msgstr "Хэрэгслийн зохиогчийн туслахууд"

#: src/uagent/util_tools.py:2546
msgid ":tool create <name> [--lang python|rust] [--description '...']"
msgstr ":хэрэгсэл үүсгэх <нэр> [--lang python|зэв] [--тайлбар '...']"

#: src/uagent/util_tools.py:2547
msgid "Scaffolds src/uagent/tools/<name>_tool.py (+ json)."
msgstr "Scaffolds src/uagent/tools/<name>_tool.py (+ json)."

#: src/uagent/util_tools.py:2550
msgid "Install and manage plugins"
msgstr "Залгаасуудыг суулгаж удирдах"

#: src/uagent/util_tools.py:2551
msgid ""
":plugin "
"<list|install|remove|enable|disable|reload|info|init|validate|marketplace>"
" ..."
msgstr ""
":plugin <жагсаалт|суулгах|устгах|идэвхжүүлэх|идэвхгүй болгох|дахин "
"ачаалах|мэдээлэл|init|баталгаажуулах|зах зээл> ..."

#: src/uagent/util_tools.py:2552
msgid "See :help plugin <subcommand> for each action."
msgstr "Үйлдэл бүрийг :help залгаас <дэд команд> харна уу."

#: src/uagent/util_tools.py:2555
msgid "Auto-pilot: repeatedly pursue a goal until done or stopped"
msgstr "Автомат нисгэгч: зорилгоо биелүүлэх эсвэл зогсоох хүртэл давтан биелүүлэх"

#: src/uagent/util_tools.py:2556
msgid ":auto <goal> [--max-rounds N] | :auto off"
msgstr ":auto <зорилго> [--хамгийн их тойрог N] | :auto хямдарлаа"

