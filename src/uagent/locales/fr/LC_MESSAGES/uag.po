#: src/uagent/util_tools.py:2618
msgid ""
":tools on|off           Enable/disable sending tools to the LLM\n"
":tools on|off <genre>   Enable/disable a tool genre (and sync global on)\n"
":tools list [query]     List loaded tools\n"
":tools load <name>      Load one tool by name\n"
":tools reload           Reload tool modules from disk\n"
":tools output           Toggle showing tool results in UI\n"
":tools create ...       Scaffold a new tool (alias of :tool create)"
msgstr ""
":tools on|off Activer/désactiver l'envoi d'outils au LLM\n"
":tools on|off <genre> Activer/désactiver un genre d'outil (et synchronisation globale activée)\n"
":tools list [query] Liste des outils chargés\n"
":tools load <nom> Charger un outil par nom\n"
":tools reload Recharger les modules d'outils à partir du disque\n"
":tools sortie Basculer l'affichage des résultats de l'outil dans UI\n"
":tools create ... Échafaudage d'un nouvel outil (alias de :tool create)"

