msgstr ":skills [liste|active|clear|install|uninstall|apm|mp_search] ..."

#: src/uagent/util_tools.py:2526
msgid ""
"Built-in: list/active/clear (see runtime skills handlers).\n"
"Dynamic subcommands come from tool CMD_SPEC (install, uninstall, apm, "
"mp_search).\n"
"Use :help skills install for a subcommand."
msgstr ""
"Intégré : list/active/clear (voir gestionnaires de compétences "
"d'exécution).\n"
"Les sous-commandes dynamiques proviennent de l'outil CMD_SPEC "
"(installation, désinstallation, apm, mp_search).\n"
"Utilisez :help skills install pour une sous-commande."

