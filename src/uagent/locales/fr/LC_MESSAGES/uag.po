msgstr ""
"[INFO] shrink_llm: {old_n} -> {new_n} messages ({old_part_n} anciens "
"messages compressés en 1 résumé ; {tail_n} conservés à la fin)"

#: src/uagent/core.py:1788
msgid ""
"[WARN] history compression hit context length even at chunk_size=1; "
