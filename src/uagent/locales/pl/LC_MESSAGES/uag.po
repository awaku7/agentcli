msgstr ""
"idx pochodzi z :logs. Po załadowaniu możesz zostać poproszony o dodanie do "
"dziennika bieżącej sesji."

#: src/uagent/util_tools.py:2567
msgid "Load the newest log (:load 0)"
msgstr "Załaduj najnowszy log (:load 0)"

#: src/uagent/util_tools.py:2568
msgid ":cont"
msgstr ":cd"

#: src/uagent/util_tools.py:2571
msgid "Delete short conversation logs"
msgstr "Usuń krótkie dzienniki rozmów"

#: src/uagent/util_tools.py:2572
msgid ":clean [N]"
msgstr ":czysty [N]"

#: src/uagent/util_tools.py:2574
msgid ""
"Deletes scheck_log_*.jsonl where user-turn count (role=user) <= N (default "
"5, or UAGENT_CLEAN_THRESHOLD). On :exit/:quit/Ctrl-C, the current session "
"log is discarded under the same rule. A silent startup sweep also removes "
"leftover short logs from prior sessions."
msgstr ""
"Usuwa scheck_log_*.jsonl, gdzie liczba zwrotów użytkownika (rola=użytkownik)"
" <= N (domyślnie 5 lub UAGENT_CLEAN_THRESHOLD). W przypadku "
":exit/:quit/Ctrl-C bieżący dziennik sesji jest odrzucany zgodnie z tą samą "
"regułą. Ciche przeglądanie przy uruchamianiu usuwa również resztki krótkich "
"dzienników z poprzednich sesji."

#: src/uagent/util_tools.py:2581
msgid "Shrink conversation history"
msgstr "Zmniejsz historię rozmów"

#: src/uagent/util_tools.py:2582
msgid ":shrink [N]"
msgstr ":zmniejszyć [N]"

#: src/uagent/util_tools.py:2583
msgid "Keep last N non-system messages (default 40)."
msgstr "Zachowaj N ostatnich wiadomości niesystemowych (domyślnie 40)."

#: src/uagent/util_tools.py:2586
msgid "Shrink history via LLM summarization"
msgstr "Zmniejsz historię poprzez podsumowanie LLM"

#: src/uagent/util_tools.py:2587
msgid ":shrink_llm [N]"
msgstr ":shrink_llm [N]"

#: src/uagent/util_tools.py:2589
msgid ""
"Summarize older history into one system message; keep last N raw (default "
