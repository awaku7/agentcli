msgstr "[sessions] Dapat non-negative integer ang --keep."

msgid "[sessions] Prune plan: keep newest %(keep)d, candidates=%(count)d"
msgstr ""
"[sessions] Plano ng paglilinis: panatilihin ang pinakabago %(keep)d, mga "
"kandidato=%(count)d"

msgid "  %(id)s | %(created_at)s | %(count)d messages"
msgstr "  %(id)s | %(created_at)s | %(count)d mensahe"

msgid ""
"[sessions] Dry run; nothing deleted. Add --yes to delete these sessions."
msgstr ""
"[sessions] Dry run; walang tinanggal. Idagdag ang --yes para tanggalin ang "
"mga session na ito."

msgid "[sessions] Failed to delete %(id)s: %(error)s"
msgstr "[sessions] Hindi matanggal ang %(id)s: %(error)s"

msgid "[sessions] VACUUM failed: %(error)s"
msgstr "[sessions] Nabigo ang VACUUM: %(error)s"

msgid "[sessions] Pruned %(deleted)d/%(total)d session(s)."
msgstr "[sessions] Nilinis ang %(deleted)d sa %(total)d session."

msgid "[sessions] Session store or LLM is not enabled."
msgstr "[sessions] Hindi naka-enable ang imbakan ng session o LLM."

msgid "[sessions] Summarizing %(count)d session(s)..."
msgstr "[sessions] Sinusuma ang %(count)d session..."

msgid "[%(index)d/%(total)d] %(id)s  skipped"
msgstr "[%(index)d/%(total)d] %(id)s  nilaktawan"

msgid "[%(index)d/%(total)d] %(id)s  skipped (too short)"
msgstr "[%(index)d/%(total)d] %(id)s  nilaktawan (masyadong maikli)"

msgid "[%(index)d/%(total)d] %(id)s  saved"
msgstr "[%(index)d/%(total)d] %(id)s  nai-save"

msgid "[%(index)d/%(total)d] %(id)s  failed: %(error)s"
msgstr "[%(index)d/%(total)d] %(id)s  nabigo: %(error)s"

msgid ""
"[sessions] Complete: %(done)d summarized, %(skipped)d skipped, %(failed)d "
"failed"
msgstr ""
"[sessions] Kumpleto: %(done)d ang sinuma, %(skipped)d nilaktawan, %(failed)d"
" nabigo"

msgid "[sessions] No memory candidates."
msgstr "[sessions] Walang memory candidate."

msgid "[sessions] Memory candidates:"
msgstr "[sessions] Mga memory candidate:"

msgid "[sessions] Usage: :sessions approve <number>"
msgstr "[sessions] Paggamit: :sessions approve <number>"

msgid "[sessions] Memory candidate approved."
msgstr "[sessions] Naaprubahan ang memory candidate."

msgid "Embedded mode: disables the session store (UAGENT_SESSION_STORE=0) and hides tool management tools (tool_catalog, tool_load, unload_tool)."
msgstr ""
