msgstr "Consulte o plugin :help <subcommand> para cada ação."

#: src/uagent/util_tools.py:2640
msgid "Auto-pilot: repeatedly pursue a goal until done or stopped"
msgstr ""
"Piloto automático: perseguir repetidamente um objetivo até que seja "
"concluído ou interrompido"

#: src/uagent/util_tools.py:2641
