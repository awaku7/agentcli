#: src/uagent/util_tools.py:2572
msgid ":clean [N]"
msgstr ":limpar [N]"

#: src/uagent/util_tools.py:2574
msgid ""
"Deletes scheck_log_*.jsonl where user-turn count (role=user) <= N (default "
"5, or UAGENT_CLEAN_THRESHOLD). On :exit/:quit/Ctrl-C, the current session "
"log is discarded under the same rule. A silent startup sweep also removes "
"leftover short logs from prior sessions."
msgstr ""
"Exclui scheck_log_*.jsonl onde contagem de turnos do usuário (role=user) <= "
"N (padrão 5 ou UAGENT_CLEAN_THRESHOLD). Em :exit/:quit/Ctrl-C, o log da "
"sessão atual é descartado sob a mesma regra. Uma varredura de inicialização "
"silenciosa também remove registros curtos restantes de sessões anteriores."

#: src/uagent/util_tools.py:2581
msgid "Shrink conversation history"
msgstr "Reduzir o histórico de conversas"

#: src/uagent/util_tools.py:2582
msgid ":shrink [N]"
msgstr ":encolher [N]"

#: src/uagent/util_tools.py:2583
msgid "Keep last N non-system messages (default 40)."
msgstr "Mantenha as últimas N mensagens que não sejam do sistema (padrão 40)."

#: src/uagent/util_tools.py:2586
msgid "Shrink history via LLM summarization"
msgstr "Reduzir o histórico por meio do resumo LLM"

#: src/uagent/util_tools.py:2587
msgid ":shrink_llm [N]"
msgstr ":shrink_llm [N]"

#: src/uagent/util_tools.py:2589
msgid ""
"Summarize older history into one system message; keep last N raw (default "
"20)."
msgstr ""
"Resuma o histórico antigo em uma mensagem do sistema; mantenha o último N "
"bruto (padrão 20)."

