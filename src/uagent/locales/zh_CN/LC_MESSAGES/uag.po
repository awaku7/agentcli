msgstr "删除简短的对话日志"

#: src/uagent/util_help.py:150
msgid ""
"Deletes scheck_log_*.jsonl where user-turn count (role=user) <= N (default "
"5, or UAGENT_CLEAN_THRESHOLD). On :exit/:quit/Ctrl-C, the current session "
"log is discarded under the same rule. A silent startup sweep also removes "
"leftover short logs from prior sessions."
msgstr ""
"删除 scheck_log_*.jsonl，其中用户轮次计数 (role=user) <= N（默认 5 或 "
"UAGENT_CLEAN_THRESHOLD）。在 :exit/:quit/Ctrl-C "
"上，当前会话日志将根据相同规则被丢弃。静默启动扫描还会删除先前会话中剩余的短日志。"

#: src/uagent/util_help.py:157
msgid "Shrink conversation history"
msgstr "缩小对话历史记录"

#: src/uagent/util_help.py:159
msgid "Keep last N non-system messages (default 40)."
msgstr "保留最后 N 个非系统消息（默认 40）。"

#: src/uagent/util_help.py:162
msgid "Shrink history via LLM summarization"
msgstr "通过 LLM 汇总缩小历史记录"

#: src/uagent/util_help.py:165
msgid ""
"Summarize older history into one system message; keep last N raw (default "
"20)."
msgstr "将较旧的历史记录汇总为一条系统消息；保留最后 N 个原始数据（默认 20）。"

#: src/uagent/util_help.py:169
msgid "Show approximate token count of the conversation"
msgstr "显示对话的大概令牌数"

#: src/uagent/util_help.py:176
msgid ""
"Manage the current Responses API response. status retrieves the current "
"response; cancel stops it; tokens counts input tokens; compact compacts "
"context; items lists input items; delete removes a response."
msgstr ""
"管理当前的 Responses API 响应。 status 检索当前响应；取消停止它； tokens 计算输入的 tokens；紧凑的上下文； "
"items 列出输入项目；删除会删除响应。"

#: src/uagent/util_help.py:183
msgid "Manage UAGENT_* environment variables"
msgstr "管理 UAGENT_* 环境变量"

#: src/uagent/util_help.py:186
msgid ""
"Sensitive KEY names are masked on show. save writes encrypted .env.sec when "
"configured."
msgstr "敏感的 KEY 名称在显示时被屏蔽。配置时 save 会写入加密的 .env.sec。"

#: src/uagent/util_help.py:190
msgid "Manage and apply Agent Skills"
msgstr "管理和应用代理技能"

#: src/uagent/util_help.py:193
msgid ""
"Built-in: list/active/clear (see runtime skills handlers).\n"
":skills list <keyword>  Filter skills by keyword (name/description).\n"
":skills find <keyword>  Same as list with filter.\n"
"Dynamic subcommands come from tool CMD_SPEC (install, uninstall, apm, mp_search).\n"
"Use :help skills install for a subcommand."
msgstr ""
"Built-in: list/active/clear (see runtime skills handlers).\n"
":skills list <keyword>  Filter skills by keyword (name/description).\n"
":skills find <keyword>  Same as list with filter.\n"
"Dynamic subcommands come from tool CMD_SPEC (install, uninstall, apm, mp_search).\n"
"Use :help skills install for a subcommand."

#: src/uagent/util_help.py:201
msgid "Control tool sending, genres, and loaded tools"
msgstr "控制工具发送、流派和加载的工具"

#: src/uagent/util_help.py:204
msgid ""
":tools on|off           Enable/disable sending tools to the LLM\n"
":tools on|off <genre>   Enable/disable a tool genre (and sync global on)\n"
":tools list [query]     List loaded tools\n"
":tools load <name>      Load one tool by name\n"
":tools reload           Reload tool modules from disk\n"
":tools output           Toggle showing tool results in UI"
msgstr ""
":tools on|off           Enable/disable sending tools to the LLM\n"
":tools on|off <genre>   Enable/disable a tool genre (and sync global on)\n"
":tools list [query]     List loaded tools\n"
":tools load <name>      Load one tool by name\n"
":tools reload           Reload tool modules from disk\n"
":tools output           Toggle showing tool results in UI"

