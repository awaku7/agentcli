#: src/uagent/welcome.py:64
msgid "[Quick Guide]"
msgstr "[Γρήγορος οδηγός]"

#: src/uagent/welcome.py:65
msgid "- Chat: type a message and send (GUI: Ctrl+Enter is also available)."
msgstr ""
"- Συνομιλία: πληκτρολογήστε ένα μήνυμα και στείλτε το (GUI: Ctrl+Enter "
"είναι επίσης διαθέσιμο).girin (\"\"\" sonu ile bitirin)."

#: src/uagent/welcome.py:66
msgid "- Multiline: enter a line that is just 'f' to enter multiline mode."
msgstr ""
"- Multiline: εισαγάγετε μια γραμμή που είναι απλώς \"f\" για να εισέλθετε"
" σε λειτουργία πολλαπλών γραμμών."

#: src/uagent/welcome.py:68
msgid ""
"- Commands: type ':help' to see system commands (log management, history "
"compression, etc.). Note: commands start with ':' (colon) instead of '/' "
"(slash)."
msgstr ""
"- Εντολές: πληκτρολογήστε ':help' για να δείτε εντολές συστήματος "
"(διαχείριση αρχείων καταγραφής, συμπίεση ιστορικού κ.λπ.). Σημείωση: οι "
"εντολές ξεκινούν με ':' (άνω τελεία) αντί για '/' (κάθετο)."

#: src/uagent/welcome.py:70
msgid "- Exit: ':exit' or ':quit' ends the session."
msgstr "- Έξοδος: «:exit» ή «:quit» τερματίζει τη συνεδρία."

#: src/uagent/welcome.py:72
msgid ""
"- Images: GUI supports drag & drop; in CUI you can input a file path for "
"image analysis."
msgstr ""
"- Εικόνες: Το GUI υποστηρίζει μεταφορά και απόθεση. στο CUI μπορείτε να "
"εισάγετε μια διαδρομή αρχείου για ανάλυση εικόνας."

#: src/uagent/welcome.py:75
msgid ""
"- Interrupt: press `c` key to stop the current LLM response (injected as "
"'Stop')."
msgstr ""
"- Διακοπή: πατήστε το πλήκτρο «c» για να σταματήσετε την τρέχουσα "
"απόκριση LLM (με ένεση ως «Διακοπή»)."

#: src/uagent/welcome.py:78
msgid ""
"- Auto-pilot: `:auto <goal>` repeatedly runs a task; press `x` to exit "
"immediately."
msgstr ""
"- Αυτόματος πιλότος: `:auto <goal>` εκτελεί επανειλημμένα μια εργασία. "
"πατήστε 'x' για να βγείτε αμέσως."

