msgstr ":help [εντολή [υποεντολή]]"

#: src/uagent/util_tools.py:2542
msgid ""
"Without args: short list of all commands.\n"
"With a command: detailed usage (static + dynamic CMD_SPEC).\n"
"Examples: :help tools | :help skills install | :help plugin"
msgstr ""
"Χωρίς args: σύντομη λίστα όλων των εντολών.\n"
"Με εντολή: λεπτομερής χρήση (στατική + δυναμική CMD_SPEC).\n"
"Παραδείγματα: :help εργαλεία | :help εγκατάσταση δεξιοτήτων | :help προσθήκη"

#: src/uagent/util_tools.py:2549
msgid "Change workdir without confirmation"
msgstr "Αλλάξτε το πρόγραμμα εργασίας χωρίς επιβεβαίωση"

#: src/uagent/util_tools.py:2551
msgid "Examples: :cd .. | :cd ~ | :cd C:\\path | :cd /"
msgstr "Παραδείγματα: :cd .. | :cd ~ | :cd C:\\path | :cd /"

#: src/uagent/util_tools.py:2554
msgid "List directory entries"
msgstr "Λίστα καταχωρήσεων καταλόγου"

#: src/uagent/util_tools.py:2555
msgid ":ls [path]"
msgstr ":ls [διαδρομή]"

#: src/uagent/util_tools.py:2556
msgid "Examples: :ls | :ls .. | :ls ~ | :ls C:\\path"
msgstr "Παραδείγματα: :ls | :ls .. | :ls ~ | :ls C:\\path"

#: src/uagent/util_tools.py:2558
msgid "Show conversation log file list"
msgstr "Εμφάνιση λίστας αρχείων καταγραφής συνομιλιών"

#: src/uagent/util_tools.py:2558
msgid ":logs"
msgstr ":logs"

#: src/uagent/util_tools.py:2560
msgid "Load a past log (overwrites current conversation history)"
msgstr ""
"Φόρτωση προηγούμενου αρχείου καταγραφής (αντικαθιστά το τρέχον ιστορικό "
"συνομιλιών)"

#: src/uagent/util_tools.py:2561
msgid ":load <idx|path>"
msgstr ":load <idx|διαδρομή>"

#: src/uagent/util_tools.py:2563
msgid ""
"idx is from :logs. After load you may be asked to prepend into the current "
"session log."
msgstr ""
"Το idx είναι από το :logs. Μετά τη φόρτωση μπορεί να σας ζητηθεί να "
"προσαρτήσετε στο τρέχον αρχείο καταγραφής συνεδρίας."

#: src/uagent/util_tools.py:2567
msgid "Load the newest log (:load 0)"
msgstr "Φόρτωση του νεότερου αρχείου καταγραφής (:load 0)"

#: src/uagent/util_tools.py:2568
msgid ":cont"
msgstr ":συνεχ"

#: src/uagent/util_tools.py:2571
msgid "Delete short conversation logs"
msgstr "Διαγραφή σύντομων αρχείων καταγραφής συνομιλιών"

#: src/uagent/util_tools.py:2572
msgid ":clean [N]"
msgstr ":clean [N]"

#: src/uagent/util_tools.py:2574
msgid ""
"Deletes scheck_log_*.jsonl where user-turn count (role=user) <= N (default "
"5, or UAGENT_CLEAN_THRESHOLD). On :exit/:quit/Ctrl-C, the current session "
"log is discarded under the same rule. A silent startup sweep also removes "
"leftover short logs from prior sessions."
msgstr ""
"Διαγράφει το scheck_log_*.jsonl όπου πλήθος στροφών χρήστη (ρόλος=χρήστης) "
"<= N (προεπιλογή 5 ή UAGENT_CLEAN_THRESHOLD). Στο :exit/:quit/Ctrl-C, το "
"τρέχον αρχείο καταγραφής περιόδου λειτουργίας απορρίπτεται σύμφωνα με τον "
"ίδιο κανόνα. Μια αθόρυβη σάρωση εκκίνησης αφαιρεί επίσης υπολείμματα "
"σύντομων αρχείων καταγραφής από προηγούμενες συνεδρίες."

#: src/uagent/util_tools.py:2581
msgid "Shrink conversation history"
msgstr "Συρρίκνωση ιστορικού συνομιλιών"

#: src/uagent/util_tools.py:2582
msgid ":shrink [N]"
msgstr ":shrink [N]"

#: src/uagent/util_tools.py:2583
msgid "Keep last N non-system messages (default 40)."
msgstr "Διατηρήστε τα τελευταία N μηνύματα εκτός συστήματος (προεπιλογή 40)."

#: src/uagent/util_tools.py:2586
msgid "Shrink history via LLM summarization"
msgstr "Συρρίκνωση ιστορικού μέσω LLM σύνοψης"

#: src/uagent/util_tools.py:2587
msgid ":shrink_llm [N]"
msgstr ":shrink_llm [N]"

#: src/uagent/util_tools.py:2589
msgid ""
"Summarize older history into one system message; keep last N raw (default "
"20)."
msgstr ""
"Συνοψίστε το παλαιότερο ιστορικό σε ένα μήνυμα συστήματος. κρατήστε το "
"τελευταίο N raw (προεπιλογή 20)."

#: src/uagent/util_tools.py:2593
msgid "Show approximate token count of the conversation"
msgstr "Εμφάνιση κατά προσέγγιση αριθμού διακριτικών της συνομιλίας"

#: src/uagent/util_tools.py:2594
msgid ":tokens"
msgstr ":tokens"

#: src/uagent/util_tools.py:2597
msgid "Manage UAGENT_* environment variables"
msgstr "Διαχείριση μεταβλητών περιβάλλοντος UAGENT_*"

#: src/uagent/util_tools.py:2598
msgid ":env show [KEY] | :env set KEY=VAL | :env unset KEY | :env save"
msgstr ""
":env εμφάνιση [ΚΛΕΙΔΙ] | :env σύνολο KEY=VAL | :env unset KEY | :env "
"αποθήκευση"

#: src/uagent/util_tools.py:2600
msgid ""
"Sensitive KEY names are masked on show. save writes encrypted .env.sec when "
"configured."
msgstr ""
"Τα ευαίσθητα ονόματα KEY είναι καλυμμένα στην προβολή. αποθήκευση εγγραφών "
"με κρυπτογράφηση .env.sec όταν ρυθμιστεί."

#: src/uagent/util_tools.py:2604
msgid "Manage and apply Agent Skills"
msgstr "Διαχείριση και εφαρμογή Agent Skills"

#: src/uagent/util_tools.py:2605
msgid ":skills [list|active|clear|install|uninstall|apm|mp_search] ..."
msgstr ""
":skills [λίστα|ενεργή|διαγραφή|εγκατάσταση|απεγκατάσταση|apm|mp_search] ..."

#: src/uagent/util_tools.py:2607
msgid ""
"Built-in: list/active/clear (see runtime skills handlers).\n"
":skills list <keyword>  Filter skills by keyword (name/description).\n"
":skills find <keyword>  Same as list with filter.\n"
"Dynamic subcommands come from tool CMD_SPEC (install, uninstall, apm, mp_search).\n"
"Use :help skills install for a subcommand."
msgstr ""
"Ενσωματωμένο: list/active/clear (δείτε τους χειριστές δεξιοτήτων χρόνου εκτέλεσης).\n"
":skills list <keyword> Φιλτράρετε τις δεξιότητες κατά λέξη-κλειδί (όνομα/περιγραφή).\n"
":skills εύρεση <λέξης-κλειδιού> Ίδιο με τη λίστα με το φίλτρο.\n"
"Οι δυναμικές υποεντολές προέρχονται από το εργαλείο CMDll_SPEC (unstaarch) Εγκατάσταση δεξιοτήτων :help για μια υποεντολή."

#: src/uagent/util_tools.py:2615
msgid "Control tool sending, genres, and loaded tools"
msgstr "Ελέγξτε την αποστολή εργαλείων, τα είδη και τα φορτωμένα εργαλεία"

#: src/uagent/util_tools.py:2616
msgid ":tools [list|load|on|off|reload|output|create] ..."
msgstr ""
":tools "
"[λίστα|φόρτωση|ενεργοποίηση|απενεργοποίηση|επαναφόρτωση|έξοδος|δημιουργία] "
"..."

#: src/uagent/util_tools.py:2618
msgid ""
":tools on|off           Enable/disable sending tools to the LLM\n"
":tools on|off <genre>   Enable/disable a tool genre (and sync global on)\n"
":tools list [query]     List loaded tools\n"
":tools load <name>      Load one tool by name\n"
":tools reload           Reload tool modules from disk\n"
":tools output           Toggle showing tool results in UI\n"
":tools create ...       Scaffold a new tool (alias of :tool create)"
msgstr ""
":tools on|off Ενεργοποίηση/απενεργοποίηση εργαλείων αποστολής στο LLM\n"
":tools on|off <genre> Ενεργοποίηση/απενεργοποίηση ενός είδους εργαλείου (και γενικός συγχρονισμός ενεργοποιημένος)\n"
":tools λίστα [ερώτημα] Εργαλεία φορτωμένα με λίστα\n"
":tools φόρτωση <όνομα> Φόρτωση ενός εργαλείου PH εκ νέου φόρτωση από το όνομα___μονάδα\n"
"_ Έξοδος δίσκου\n"
":tools Εναλλαγή εμφάνισης αποτελεσμάτων εργαλείου στη διεπαφή χρήστη\n"
":tools δημιουργία ... Σκαλωσίστε ένα νέο εργαλείο (ψευδώνυμο :tool create)"

#: src/uagent/util_tools.py:2628
msgid "Tool authoring helpers"
msgstr "Βοηθοί συγγραφής εργαλείων"

#: src/uagent/util_tools.py:2629
msgid ":tool create <name> [--lang python|rust] [--description '...']"
msgstr ":tool δημιουργία <όνομα> [--lang python|rust] [--περιγραφή '...']"

#: src/uagent/util_tools.py:2630
msgid "Scaffolds src/uagent/tools/<name>_tool.py (+ json)."
msgstr "Scaffolds src/uagent/tools/<name>_tool.py (+ json)."

#: src/uagent/util_tools.py:2633
msgid "Install and manage plugins"
msgstr "Εγκατάσταση και διαχείριση προσθηκών"

#: src/uagent/util_tools.py:2635
msgid ""
":plugin "
"<list|install|remove|enable|disable|reload|info|init|validate|marketplace> "
"..."
msgstr ""
":plugin "
"<λίστα|εγκατάσταση|κατάργηση|ενεργοποίηση|απενεργοποίηση|επαναφόρτωση|πληροφορίες|αρχή|επικύρωση|αγορά>"
" ..."

#: src/uagent/util_tools.py:2637
msgid "See :help plugin <subcommand> for each action."
msgstr "Δείτε :help προσθήκη <subcommand> για κάθε ενέργεια."

#: src/uagent/util_tools.py:2640
msgid "Auto-pilot: repeatedly pursue a goal until done or stopped"
msgstr ""
"Αυτόματος πιλότος: επιδιώκετε επανειλημμένα έναν στόχο μέχρι να τελειώσετε ή"
" να σταματήσετε"

#: src/uagent/util_tools.py:2641
msgid ":auto <goal> [--max-rounds N] | :auto off"
msgstr ":auto <στόχος> [--max-rounds N] | Έκπτωση :auto"

#: src/uagent/util_tools.py:2642
msgid "Press x in CLI to request immediate exit from auto-pilot."
msgstr ""
"Πατήστε x στο CLI για να ζητήσετε άμεση έξοδο από τον αυτόματο πιλότο."

#: src/uagent/util_tools.py:2645
msgid "Show detailed model configuration"
msgstr "Εμφάνιση λεπτομερούς διαμόρφωσης μοντέλου"

#: src/uagent/util_tools.py:2646
msgid ":model"
msgstr ":model"

#: src/uagent/util_tools.py:2647
msgid "Chat, image, audio, translation, embedding as configured."
msgstr "Συνομιλία, εικόνα, ήχος, μετάφραση, ενσωμάτωση όπως έχει διαμορφωθεί."

#: src/uagent/util_tools.py:2650
msgid "Set reasoning effort"
msgstr "Ορίστε συλλογιστική προσπάθεια"

#: src/uagent/util_tools.py:2651
msgid ":r [0|1|2|3|auto|minimal|low|medium|high|xhigh]"
msgstr ":r [0|1|2|3|αυτόματο|ελάχιστο|χαμηλό|μέσο|υψηλό|xhigh]"

#: src/uagent/util_tools.py:2652
msgid "0=off, 1=low, 2=medium, 3=high. Provider support varies."
msgstr ""
"0=απενεργοποίηση, 1=χαμηλή, 2=μέτρια, 3=υψηλή. Η υποστήριξη του παρόχου "
"ποικίλλει."

#: src/uagent/util_tools.py:2656
msgid "Set verbosity"
msgstr "Ρυθμίστε την πολυλογία"

#: src/uagent/util_tools.py:2657
msgid ":v [0|1|2|3]"
msgstr ":v [0|1|2|3]"

#: src/uagent/util_tools.py:2658
msgid "0=off .. 3=high. No arg keeps current."
msgstr "0=απενεργοποίηση .. 3=υψηλό. Κανένα arg δεν διατηρείται τρέχον."

#: src/uagent/util_tools.py:2661
msgid "List long-term memory notes"
msgstr "Καταγράψτε σημειώσεις μακροπρόθεσμης μνήμης"

#: src/uagent/util_tools.py:2661
msgid ":mem-list"
msgstr ":mem-list"

#: src/uagent/util_tools.py:2663
msgid "Delete a long-term memory note by index"
msgstr "Διαγράψτε μια σημείωση μακροπρόθεσμης μνήμης ανά ευρετήριο"

#: src/uagent/util_tools.py:2665
msgid "Index from :mem-list."
msgstr "Ευρετήριο από :mem-list."

#: src/uagent/util_tools.py:2668
msgid "Show or generate the learned user profile"
msgstr "Εμφάνιση ή δημιουργία του μαθημένου προφίλ χρήστη"

#: src/uagent/util_tools.py:2669
msgid ":profile | :profile fromlog [N]"
msgstr ":προφίλ | :profile fromlog [N]"

#: src/uagent/util_tools.py:2670
msgid "fromlog N uses the most recent N log files."
msgstr "Το fromlog N χρησιμοποιεί τα πιο πρόσφατα N αρχεία καταγραφής."

#: src/uagent/util_tools.py:2674
msgid "Generate user profile from past logs"
msgstr "Δημιουργήστε προφίλ χρήστη από προηγούμενα αρχεία καταγραφής"

#: src/uagent/util_tools.py:2675
msgid ":profile-fromlog [N]"
msgstr ":profile-fromlog [N]"

#: src/uagent/util_tools.py:2676
msgid "Default N=100; 0=all."
msgstr "Προεπιλογή N=100; 0=όλα."

#: src/uagent/util_tools.py:2679
msgid "Clear learned user profile data"
msgstr "Διαγράψτε τα δεδομένα προφίλ χρήστη που έχουν μάθει"

#: src/uagent/util_tools.py:2679
msgid ":profile-clear"
msgstr ":profile-clear"

#: src/uagent/util_tools.py:2682
msgid "Copy file or directory"
msgstr "Αντιγραφή αρχείου ή καταλόγου"

#: src/uagent/util_tools.py:2686
msgid "Move file or directory"
msgstr "Μετακίνηση αρχείου ή καταλόγου"

#: src/uagent/util_tools.py:2690
msgid "Delete file(s)/directory(ies) with preview + confirm"
msgstr "Διαγραφή αρχείων/καταλόγων με προεπισκόπηση + επιβεβαίωση"

#: src/uagent/util_tools.py:2691
msgid ":rm <path|glob>"
msgstr ":rm <διαδρομή|glob>"

#: src/uagent/util_tools.py:2694
msgid "Show the first n lines of a file"
msgstr "Εμφάνιση των πρώτων n γραμμών ενός αρχείου"

#: src/uagent/util_tools.py:2696 src/uagent/util_tools.py:2701
msgid "Default n=20."
msgstr "Προεπιλογή n=20."

#: src/uagent/util_tools.py:2699
msgid "Show the last n lines of a file"
msgstr "Εμφάνιση των τελευταίων n γραμμών ενός αρχείου"

#: src/uagent/util_tools.py:2704
msgid "Reload runtime configuration / modules"
msgstr "Επαναφόρτωση διαμόρφωσης χρόνου εκτέλεσης / λειτουργικών μονάδων"

#: src/uagent/util_tools.py:2705
msgid ":reload [target]"
msgstr ":reload [στόχος]"

#: src/uagent/util_tools.py:2708 src/uagent/util_tools.py:2711
msgid "Exit the interactive session"
msgstr "Έξοδος από τη διαδραστική συνεδρία"

#: src/uagent/util_tools.py:2708
msgid ":exit"
msgstr ":έξοδος"

#: src/uagent/util_tools.py:2711
msgid ":quit"
msgstr ": παραιτηθείτε"

