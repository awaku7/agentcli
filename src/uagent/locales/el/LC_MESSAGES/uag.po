#: src/uagent/util_tools.py:2491
msgid ":clean [N]"
msgstr ":clean [N]"

#: src/uagent/util_tools.py:2493
msgid ""
"Deletes scheck_log_*.jsonl where user-turn count (role=user) <= N "
"(default 5, or UAGENT_CLEAN_THRESHOLD). On :exit/:quit/Ctrl-C, the "
"current session log is discarded under the same rule. A silent startup "
"sweep also removes leftover short logs from prior sessions."
msgstr ""
"Διαγράφει το scheck_log_*.jsonl όπου πλήθος στροφών χρήστη "
"(ρόλος=χρήστης) <= N (προεπιλογή 5 ή UAGENT_CLEAN_THRESHOLD). Στο "
":exit/:quit/Ctrl-C, το τρέχον αρχείο καταγραφής περιόδου λειτουργίας "
"απορρίπτεται σύμφωνα με τον ίδιο κανόνα. Μια αθόρυβη σάρωση εκκίνησης "
"αφαιρεί επίσης υπολείμματα σύντομων αρχείων καταγραφής από προηγούμενες "
"συνεδρίες."

