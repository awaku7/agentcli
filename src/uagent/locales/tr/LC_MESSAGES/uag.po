msgstr "[shrink_llm] Öbek özetleniyor %(i)d/%(n)d..."

#: src/uagent/core.py:1753
msgid "Summary of the conversation so far:\n"
msgstr "Şimdiye kadarki konuşmanın özeti:\n"

#: src/uagent/core.py:1760
#, python-brace-format
msgid ""
"[INFO] shrink_llm: {old_n} -> {new_n} messages (compressed {old_part_n} "
